# ============================================================
# Multilingual Voice AI - Frontend environment variables (OPTIONAL)
# ============================================================
# Copy this file to `.env.local` (Next.js auto-loads it) only if you
# need to override the default backend URL.
#   copy .env.example .env.local   (Windows CMD)
#   cp .env.example .env.local     (Linux/macOS/Git Bash)
#
# Default: the frontend talks to FastAPI at http://127.0.0.1:8000
# This is correct for local development. Override ONLY if your
# backend is running on a different host/port.
# ============================================================

# URL of the FastAPI backend. Must NOT include a trailing slash.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
