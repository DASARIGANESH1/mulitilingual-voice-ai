# ============================================================
# Multilingual Voice AI - Backend environment variables
# ============================================================
# Copy this file to `.env` and fill in your own keys.
#   copy .env.example .env       (Windows CMD)
#   cp .env.example .env         (Linux/macOS/Git Bash)
# ============================================================

# ---------- Groq (Speech-to-Text, Whisper Large V3 Turbo) ----------
# 1. Create a free account at https://console.groq.com
# 2. Go to "API Keys" and create a new key.
# 3. Free tier limits: https://console.groq.com/docs/rate-limits
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---------- Google Gemini (LLM / NLG, free tier) ----------
# 1. Visit https://aistudio.google.com/apikey
# 2. Sign in with a Google account, click "Create API key".
# 3. Free tier limits: https://ai.google.dev/pricing
# A free-tier model like "gemini-2.0-flash" or "gemini-1.5-flash"
# works well. Update GEMINI_MODEL when Google releases new free-tier models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- ElevenLabs (Text-to-Speech) ----------
# 1. Create a free account at https://elevenlabs.io
# 2. Profile -> API Keys -> Create API key.
# 3. Voice ID: open https://elevenlabs.io/app/voice-lab, choose a multilingual
#    voice (e.g. "Rachel", "Adam", "Antoni", "Bella") and copy its Voice ID.
# 4. Model ID: use a multilingual model. Recommended:
#      eleven_multilingual_v2   (best quality, supports 29+ languages)
#      eleven_turbo_v2_5         (faster, also multilingual)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------- Backend runtime settings ----------
# Port the FastAPI server will listen on. Default 8000.
BACKEND_PORT=8000

# Comma-separated list of allowed origins for CORS.
# The Next.js dev server runs on http://localhost:3000 by default.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max audio upload size in megabytes (defensive limit).
BACKEND_MAX_AUDIO_MB=25

# Maximum conversation history messages kept per /api/chat request
# (each entry is one user or assistant turn). Keeping this small avoids
# blowing up the Gemini context window and reduces latency.
BACKEND_MAX_HISTORY=10
